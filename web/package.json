{
  "name": "nord-review",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:fresh": "rm -rf .data && mkdir -p .data/db && drizzle-kit migrate && nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "TEST_E2E=true vitest run --coverage",
    "test:unit": "vitest run --coverage",
    "test:e2e": "TEST_E2E=true vitest run tests/e2e/",
    "test:playwright": "playwright test",
    "check": "eslint . && nuxt typecheck"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@nuxthub/core": "^0.10.8",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/mdc": "^0.22.2",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-vue-next": "^0.577.0",
    "nanoid": "^5.1.16",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "nuxt-llms": "^0.2.0",
    "reka-ui": "^2.10.5",
    "resend": "^6.31.0",
    "shadcn-nuxt": "^2.8.2",
    "slugify": "^1.6.9",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.43",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@nuxtjs/mcp-toolkit": "^0.12.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-plugin-format": "^2.0.1",
    "lint-staged": "^16.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "h3": "^1.15.6"
    }
  },
  "lint-staged": {
    "*.{js,ts,vue,json,md,yml,yaml}": [
      "eslint --no-warn-ignored --fix"
    ]
  }
}
